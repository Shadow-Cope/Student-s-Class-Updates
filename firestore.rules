rules_version = '2';

// Student's Class — starter rules.
// Paste this into Firebase console -> Build -> Firestore Database -> Rules -> Publish.
// Authenticated users can list classes (needed for join-by-code), create classes,
// and read everything. Only the class owner can edit/delete the class itself.
// Members can post and manage homework; done-status is per user.

service cloud.firestore {
  // Owner has everything; other members only the perms granted on the class doc:
  // perms = { uid: ["announce","homework","grades","panel"] }
  function hasPerm(classId, perm) {
    let c = get(/databases/$(database)/documents/classes/$(classId)).data;
    return c.ownerUid == request.auth.uid
      || (('perms' in c) && (request.auth.uid in c.perms) && (perm in c.perms[request.auth.uid]));
  }

  match /databases/{database}/documents {

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code is string;
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']));
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if request.auth != null;
        // Users can add/remove THEMSELVES (join/leave). Owners can manage anyone.
        allow create, delete: if request.auth != null
          && (uid == request.auth.uid
              || get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid);
        allow update: if request.auth != null
          && (uid == request.auth.uid
              || get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid);
      }

      match /posts/{postId} {
        allow read: if request.auth != null;
        // Announcements: owner or members with the "announce" permission.
        allow create: if request.auth != null && hasPerm(classId, 'announce');
        // Pinning is announcement management: author, owner or announce-permission.
        allow update: if request.auth != null
          && (resource.data.authorUid == request.auth.uid || hasPerm(classId, 'announce'));
        allow delete: if request.auth != null
          && (resource.data.authorUid == request.auth.uid
              || get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid);

        // Comment threads: any class member can comment; only author/owner can delete.
        match /comments/{commentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && (get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid
                || exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));
          allow delete: if request.auth != null
            && (resource.data.authorUid == request.auth.uid
                || get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid);
        }
      }

      match /assignments/{assignId} {
        allow read: if request.auth != null;
        // Homework: owner or members with the "homework" permission.
        allow create: if request.auth != null && hasPerm(classId, 'homework');
        // Done-toggles touch only doneBy; grades need the "grades" permission; owners: everything.
        allow update: if request.auth != null
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doneBy'])
              || hasPerm(classId, 'grades'));
        allow delete: if request.auth != null
          && hasPerm(classId, 'homework');

        // Comment threads on homework: same access as post comments.
        match /comments/{commentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && (get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid
                || exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)));
          allow delete: if request.auth != null
            && (resource.data.authorUid == request.auth.uid
                || get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid);
        }

        // Submissions: each student writes their own doc (id = uid);
        // feedback is written by owner / grades-permission holders.
        match /submissions/{subId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null && subId == request.auth.uid
            && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid));
          allow update: if request.auth != null
            && (subId == request.auth.uid || hasPerm(classId, 'grades'));
          allow delete: if request.auth != null
            && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
        }
      }
    }
  }
}
